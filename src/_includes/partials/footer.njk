<footer class="site-footer">
  <div class="container">
    <div class="footer-logo">
      {% include "partials/logo-mark.njk" %}
      <p>{{ site.footer.tagline }}</p>
    </div>
    <div>
      <h3>{{ site.footer.contact_heading }}</h3>
      <p>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a><br>
        <a href="{{ site.contact.linkedin }}">{{ site.labels.linkedin }}</a>
      </p>
    </div>
    <div>
      <h3>{{ site.footer.explore_heading }}</h3>
      <ul class="footer-links">
        {% for item in site.nav %}
          {% if item.url %}
          <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% elif item.dropdown %}
            {% for sub in item.dropdown %}
            <li><a href="{{ sub.url }}">{{ sub.label }}</a></li>
            {% endfor %}
          {% endif %}
        {% endfor %}
        <li><a href="{{ site.nav_cta.url }}">{{ site.nav_cta.label }}</a></li>
      </ul>
    </div>
    <p class="footer-copyright">© {{ currentYear }} {{ site.footer.copyright_holder }} · {{ site.footer.location }}</p>
  </div>
</footer>
