<header class="site-header">
  <div class="container">
    <a class="logo" href="/" aria-label="{{ site.name }} home">
      {% set logoId = "nav" %}
      {% include "partials/logo-mark.njk" %}
    </a>
    <div class="nav-right">
      <nav aria-label="Primary">
        <ul class="nav-links">
          {% for item in site.nav %}
          <li>
            {% if item.dropdown %}
            <details class="nav-dropdown">
              <summary>{{ item.label }}</summary>
              <ul class="nav-dropdown-menu">
                {% for sub in item.dropdown %}
                <li><a href="{{ sub.url }}" {% if page.url == sub.url %}aria-current="page"{% endif %}>{{ sub.label }}</a></li>
                {% endfor %}
              </ul>
            </details>
            {% else %}
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="btn btn-primary btn-small" href="{{ site.nav_cta.url }}">{{ site.nav_cta.label }}</a>
    </div>
  </div>
</header>
