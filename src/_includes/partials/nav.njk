<header class="site-header">
  <div class="container">
    <a class="logo" href="/" aria-label="{{ site.name }} home">
      <img src="/assets/logo.svg" alt="{{ site.name }}">
    </a>
    <div class="nav-right">
      <nav aria-label="Primary">
        <ul class="nav-links">
          {% for item in site.nav %}
          <li>
            {% if item.dropdown %}
            <details class="nav-dropdown">
              <summary>{{ item.label }}</summary>
              <ul class="nav-dropdown-menu">
                {% for sub in item.dropdown %}
                <li><a href="{{ sub.url }}" {% if page.url == sub.url %}aria-current="page"{% endif %}>{{ sub.label }}</a></li>
                {% endfor %}
              </ul>
            </details>
            {% else %}
            <a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </nav>
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">🌙</button>
    </div>
  </div>
</header>
