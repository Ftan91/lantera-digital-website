{# The logo artwork, cut out of the original lantera-logo-horizontal-bg.png.
   logo-light.png has dark text for the ivory header in light mode;
   logo-dark.png is the original colours, for dark mode and the footer.
   CSS shows exactly one of the two (see .logo-mark in styles.css). #}
<span class="logo-mark">
  <img class="logo-on-light" src="/assets/logo-light.png" alt="{{ site.name }}" width="241" height="36">
  <img class="logo-on-dark" hidden src="/assets/logo-dark.png" alt="{{ site.name }}" width="241" height="36">
</span>
