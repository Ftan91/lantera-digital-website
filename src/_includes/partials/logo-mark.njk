{# The wordmark is live text in the site's serif, so it stays sharp and its
   colours follow the theme (see .logo-mark in styles.css). "Lantera" and
   "Digital" come from site.name. #}
{% set nameParts = site.name.split(" ") %}
<span class="logo-mark" role="img" aria-label="{{ site.name }}">
  <svg class="logo-flame" viewBox="0 0 20 29" aria-hidden="true">
    <path d="M10 1C12.6 7.2 18 12.4 18 19.6a8 8 0 0 1-16 0C2 12.4 7.4 7.2 10 1Z" fill="#d7923c"/>
    <path d="M10 11.5c1.3 3.1 3.6 4.9 3.6 8.4a3.6 3.6 0 0 1-7.2 0c0-3.5 2.3-5.3 3.6-8.4Z" fill="#f5dea8"/>
  </svg>
  <span class="logo-primary">{{ nameParts[0] }}</span><span class="logo-secondary">{{ nameParts[1] }}</span>
</span>
