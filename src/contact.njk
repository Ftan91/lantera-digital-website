---
layout: layouts/base.njk
title: Contact
description: "Get in touch with Lantera Digital."
permalink: /contact/
---
<section class="page-hero">
  <div class="container">
    <h1>{{ site.cta.heading }}</h1>
    <p>{{ site.cta.body }}</p>
  </div>
</section>

<section>
  <div class="container" style="max-width: 560px;">
    <div class="card contact-card">
      <h3>{{ site.labels.email }}</h3>
      <p><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></p>
      <h3>{{ site.labels.linkedin }}</h3>
      <p><a href="{{ site.contact.linkedin }}">{{ site.contact.linkedin }}</a></p>
      <h3>{{ site.labels.based_in }}</h3>
      <p>{{ site.footer.location }}</p>
    </div>
  </div>
</section>
